"use client";

import Link from "next/link";
import { FormEvent, useState } from "react";
import { useParams, useRouter } from "next/navigation";

import { createClient } from "@/lib/supabase/client";

const DAYS = [
  {
    value: "monday",
    label: "Monday",
    dayNumber: 1,
  },
  {
    value: "tuesday",
    label: "Tuesday",
    dayNumber: 2,
  },
  {
    value: "wednesday",
    label: "Wednesday",
    dayNumber: 3,
  },
  {
    value: "thursday",
    label: "Thursday",
    dayNumber: 4,
  },
  {
    value: "friday",
    label: "Friday",
    dayNumber: 5,
  },
  {
    value: "saturday",
    label: "Saturday",
    dayNumber: 6,
  },
  {
    value: "sunday",
    label: "Sunday",
    dayNumber: 0,
  },
];

export default function NewEnrollmentPage() {
  const router = useRouter();
  const params = useParams();

  const locale =
    typeof params.locale === "string"
      ? params.locale
      : "en";

  const supabase = createClient();

  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");

  const [form, setForm] = useState({
    fullName: "",
    preferredName: "",
    email: "",
    contactMethod: "",
    country: "",
    preferredLanguage: "",
    timezone: "Asia/Seoul",

    packageName: "20 Lessons",
    numberOfLessons: "20",
    lessonDuration: "25",

    tuitionAmount: "130000",
    currency: "KRW",

    startDate: "",
    scheduleDays: [] as string[],
    scheduleTime: "",
  });

  function updateField(
    field: keyof typeof form,
    value: string
  ) {
    setForm((current) => ({
      ...current,
      [field]: value,
    }));
  }

  function toggleDay(day: string) {
    setForm((current) => {
      const selected =
        current.scheduleDays.includes(day);

      return {
        ...current,
        scheduleDays: selected
          ? current.scheduleDays.filter(
              (item) => item !== day
            )
          : [...current.scheduleDays, day],
      };
    });
  }

  /*
   * Generate recurring lesson dates.
   *
   * Example:
   * Start date: Monday
   * Selected days: Monday + Wednesday
   * Number of lessons: 20
   *
   * The function will generate the next 20
   * Mondays and Wednesdays starting from the
   * selected start date.
   */
  function generateLessonDates(
    startDate: string,
    scheduleDays: string[],
    numberOfLessons: number
  ) {
    const selectedDayNumbers = scheduleDays
      .map(
        (day) =>
          DAYS.find(
            (item) => item.value === day
          )?.dayNumber
      )
      .filter(
        (dayNumber): dayNumber is number =>
          dayNumber !== undefined
      );

    if (
      !startDate ||
      selectedDayNumbers.length === 0 ||
      numberOfLessons <= 0
    ) {
      return [];
    }

    const dates: string[] = [];

    /*
     * Use UTC so the generated YYYY-MM-DD values
     * do not shift because of the browser's timezone.
     */
    const currentDate = new Date(
      `${startDate}T00:00:00Z`
    );

    while (dates.length < numberOfLessons) {
      const currentDay =
        currentDate.getUTCDay();

      if (
        selectedDayNumbers.includes(currentDay)
      ) {
        const year =
          currentDate.getUTCFullYear();

        const month = String(
          currentDate.getUTCMonth() + 1
        ).padStart(2, "0");

        const day = String(
          currentDate.getUTCDate()
        ).padStart(2, "0");

        dates.push(
          `${year}-${month}-${day}`
        );
      }

      currentDate.setUTCDate(
        currentDate.getUTCDate() + 1
      );
    }

    return dates;
  }

  async function handleSubmit(
    event: FormEvent<HTMLFormElement>
  ) {
    event.preventDefault();

    if (loading) {
      return;
    }

    setError("");
    setLoading(true);

    /*
     * BASIC VALIDATION
     */

    if (!form.fullName.trim()) {
      setError(
        "Please enter the student's full name."
      );
      setLoading(false);
      return;
    }

    if (form.scheduleDays.length === 0) {
      setError(
        "Please select at least one lesson day."
      );
      setLoading(false);
      return;
    }

    if (!form.scheduleTime) {
      setError(
        "Please select a lesson time."
      );
      setLoading(false);
      return;
    }

    if (!form.startDate) {
      setError(
        "Please select a start date."
      );
      setLoading(false);
      return;
    }

    /*
     * NUMBER VALIDATION
     */

    const numberOfLessons = Number(
      form.numberOfLessons
    );

    const lessonDuration = Number(
      form.lessonDuration
    );

    const tuitionAmount = Number(
      form.tuitionAmount
    );

    if (
      !Number.isInteger(numberOfLessons) ||
      numberOfLessons <= 0
    ) {
      setError(
        "Number of lessons must be greater than zero."
      );
      setLoading(false);
      return;
    }

    if (
      !Number.isInteger(lessonDuration) ||
      lessonDuration <= 0
    ) {
      setError(
        "Lesson duration must be greater than zero."
      );
      setLoading(false);
      return;
    }

    if (
      Number.isNaN(tuitionAmount) ||
      tuitionAmount < 0
    ) {
      setError(
        "Please enter a valid tuition amount."
      );
      setLoading(false);
      return;
    }

    /*
     * VALIDATE START DATE
     *
     * The start date must be one of the selected
     * recurring lesson days.
     */

    const startDateObject = new Date(
      `${form.startDate}T00:00:00Z`
    );

    const startDayNumber =
      startDateObject.getUTCDay();

    const startDay = DAYS.find(
      (day) =>
        day.dayNumber === startDayNumber
    );

    if (
      !startDay ||
      !form.scheduleDays.includes(
        startDay.value
      )
    ) {
      setError(
        "The start date must fall on one of the selected lesson days."
      );
      setLoading(false);
      return;
    }

    /*
     * GENERATE THE COMPLETE SCHEDULE BEFORE
     * CREATING DATABASE RECORDS.
     */

    const lessonDates =
      generateLessonDates(
        form.startDate,
        form.scheduleDays,
        numberOfLessons
      );

    if (
      lessonDates.length !== numberOfLessons
    ) {
      setError(
        "Could not generate the complete lesson schedule."
      );
      setLoading(false);
      return;
    }

    try {
      /*
       * STEP 1
       * CREATE STUDENT
       */

      const {
        data: student,
        error: studentError,
      } = await supabase
        .from("students")
        .insert({
          full_name:
            form.fullName.trim(),

          preferred_name:
            form.preferredName.trim() || null,

          email:
            form.email.trim() || null,

          contact_method:
            form.contactMethod.trim() || null,

          country:
            form.country.trim() || null,

          preferred_language:
            form.preferredLanguage.trim() || null,

          timezone:
            form.timezone.trim() || null,
        })
        .select("id")
        .single();

      if (studentError) {
        throw new Error(
          `Could not create student: ${studentError.message}`
        );
      }

      if (!student) {
        throw new Error(
          "Student was created, but no student ID was returned."
        );
      }

      /*
       * STEP 2
       * CREATE ACTIVE ENROLLMENT
       */

      const {
        data: enrollment,
        error: enrollmentError,
      } = await supabase
        .from("enrollments")
        .insert({
          student_id:
            student.id,

          package_name:
            form.packageName.trim(),

          number_of_lessons:
            numberOfLessons,

          lesson_duration:
            lessonDuration,

          lessons_per_week:
            form.scheduleDays.length,

          schedule_days:
            form.scheduleDays,

          schedule_time:
            form.scheduleTime,

          tuition_amount:
            tuitionAmount,

          currency:
            form.currency,

          start_date:
            form.startDate,

          status:
            "active",
        })
        .select("id")
        .single();

      if (enrollmentError) {
        throw new Error(
          `Student was created, but the enrollment could not be created: ${enrollmentError.message}`
        );
      }

      if (!enrollment) {
        throw new Error(
          "Enrollment was created, but no enrollment ID was returned."
        );
      }

      /*
       * STEP 3
       * CREATE ALL LESSON RECORDS
       *
       * Every lesson starts as "scheduled".
       *
       * You do NOT need to manually create lessons
       * after this enrollment is submitted.
       */

      const lessons = lessonDates.map(
        (lessonDate, index) => ({
          enrollment_id:
            enrollment.id,

          lesson_number:
            index + 1,

          lesson_date:
            lessonDate,

          duration:
            lessonDuration,

          attendance_status:
            "scheduled",

          notes: null,
        })
      );

      const {
        error: lessonsError,
      } = await supabase
        .from("lessons")
        .insert(lessons);

      if (lessonsError) {
        throw new Error(
          `Enrollment was created, but the lesson schedule could not be created: ${lessonsError.message}`
        );
      }

      /*
       * SUCCESS
       */

      router.push(
        `/${locale}/admin/students/${student.id}`
      );

      router.refresh();
    } catch (err) {
      setError(
        err instanceof Error
          ? err.message
          : "Something went wrong while creating the enrollment."
      );

      setLoading(false);
    }
  }

  return (
    <main
      className="
        min-h-screen
        bg-[#FAF8F5]
        px-6
        py-12
        text-[#292929]

        sm:px-8
        sm:py-16

        lg:px-10
        lg:py-20
      "
    >
      <div className="mx-auto max-w-4xl">

        {/* HEADER */}

        <div>
          <button
            type="button"
            onClick={() => router.back()}
            className="
              font-sans
              text-[13px]
              font-medium
              text-[#6F8F72]
              transition
              hover:opacity-70
            "
          >
            ← Back
          </button>

          <p
            className="
              mt-8
              font-sans
              text-[14px]
              font-medium
              tracking-[0.02em]
              text-[#6F8F72]
            "
          >
            Hamkke │ 함께
          </p>

          <h1
            className="
              mt-5
              font-serif
              text-[48px]
              font-normal
              leading-tight
              tracking-[-0.03em]

              sm:text-[56px]
            "
          >
            New Enrollment
          </h1>

          <p
            className="
              mt-4
              max-w-2xl
              font-serif
              text-[20px]
              leading-8
              text-[#666]

              sm:text-[22px]
            "
          >
            Add a student and their enrollment
            details in one place.
          </p>
        </div>

        <form
          onSubmit={handleSubmit}
          className="mt-12 space-y-8"
        >

          {/* STUDENT INFORMATION */}

          <section
            className="
              rounded-3xl
              border
              border-[#E7DDD1]
              bg-white
              p-7

              sm:p-9
            "
          >
            <p
              className="
                font-sans
                text-[11px]
                font-medium
                uppercase
                tracking-[0.14em]
                text-[#6F8F72]
              "
            >
              01
            </p>

            <h2
              className="
                mt-3
                font-serif
                text-[32px]
                font-normal
              "
            >
              Student Information
            </h2>

            <p
              className="
                mt-2
                font-sans
                text-[14px]
                leading-6
                text-[#666]
              "
            >
              Enter the student's information once.
              It will be connected to their enrollment.
            </p>

            <div
              className="
                mt-8
                grid
                gap-6

                sm:grid-cols-2
              "
            >
              <Field
                label="Full name"
                required
              >
                <input
                  required
                  value={form.fullName}
                  onChange={(event) =>
                    updateField(
                      "fullName",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Preferred name">
                <input
                  value={form.preferredName}
                  onChange={(event) =>
                    updateField(
                      "preferredName",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Email">
                <input
                  type="email"
                  value={form.email}
                  onChange={(event) =>
                    updateField(
                      "email",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Contact method">
                <input
                  placeholder="KakaoTalk, email, etc."
                  value={form.contactMethod}
                  onChange={(event) =>
                    updateField(
                      "contactMethod",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Country">
                <input
                  value={form.country}
                  onChange={(event) =>
                    updateField(
                      "country",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Preferred language">
                <input
                  placeholder="Korean, Chinese, etc."
                  value={form.preferredLanguage}
                  onChange={(event) =>
                    updateField(
                      "preferredLanguage",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field label="Timezone">
                <input
                  placeholder="Asia/Seoul"
                  value={form.timezone}
                  onChange={(event) =>
                    updateField(
                      "timezone",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>
            </div>
          </section>

          {/* ENROLLMENT DETAILS */}

          <section
            className="
              rounded-3xl
              border
              border-[#E7DDD1]
              bg-white
              p-7

              sm:p-9
            "
          >
            <p
              className="
                font-sans
                text-[11px]
                font-medium
                uppercase
                tracking-[0.14em]
                text-[#6F8F72]
              "
            >
              02
            </p>

            <h2
              className="
                mt-3
                font-serif
                text-[32px]
                font-normal
              "
            >
              Enrollment Details
            </h2>

            <p
              className="
                mt-2
                font-sans
                text-[14px]
                leading-6
                text-[#666]
              "
            >
              Set the student's current lesson package
              and recurring schedule.
            </p>

            <div
              className="
                mt-8
                grid
                gap-6

                sm:grid-cols-2
              "
            >
              <Field
                label="Package"
                required
              >
                <input
                  required
                  value={form.packageName}
                  onChange={(event) =>
                    updateField(
                      "packageName",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field
                label="Number of lessons"
                required
              >
                <input
                  required
                  type="number"
                  min="1"
                  value={form.numberOfLessons}
                  onChange={(event) =>
                    updateField(
                      "numberOfLessons",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              <Field
                label="Lesson duration (minutes)"
                required
              >
                <input
                  required
                  type="number"
                  min="1"
                  value={form.lessonDuration}
                  onChange={(event) =>
                    updateField(
                      "lessonDuration",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              {/* LESSON DAYS */}

              <div className="sm:col-span-2">
                <label
                  className="
                    font-sans
                    text-[12px]
                    font-medium
                    uppercase
                    tracking-[0.12em]
                    text-[#6F8F72]
                  "
                >
                  Lesson Days
                  <span className="ml-1 text-[#A66A5B]">
                    *
                  </span>
                </label>

                <div
                  className="
                    mt-3
                    grid
                    grid-cols-2
                    gap-3

                    sm:grid-cols-4
                    lg:grid-cols-7
                  "
                >
                  {DAYS.map((day) => {
                    const selected =
                      form.scheduleDays.includes(
                        day.value
                      );

                    return (
                      <label
                        key={day.value}
                        className={`
                          flex
                          cursor-pointer
                          items-center
                          justify-center
                          rounded-xl
                          border
                          px-3
                          py-3
                          font-sans
                          text-[13px]
                          transition

                          ${
                            selected
                              ? "border-[#6F8F72] bg-[#E2EBDD] text-[#5F7F63]"
                              : "border-[#D8CCBE] bg-[#FAF8F5] text-[#555] hover:border-[#AFA294]"
                          }
                        `}
                      >
                        <input
                          type="checkbox"
                          checked={selected}
                          onChange={() =>
                            toggleDay(day.value)
                          }
                          className="sr-only"
                        />

                        {day.label}
                      </label>
                    );
                  })}
                </div>

                <p
                  className="
                    mt-2
                    font-sans
                    text-[12px]
                    text-[#888]
                  "
                >
                  These days are used to automatically
                  generate the recurring lesson schedule.
                </p>
              </div>

              {/* LESSON TIME */}

              <Field
                label="Lesson Time"
                required
              >
                <input
                  required
                  type="time"
                  value={form.scheduleTime}
                  onChange={(event) =>
                    updateField(
                      "scheduleTime",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              {/* LESSONS PER WEEK */}

              <Field label="Lessons per week">
                <input
                  type="number"
                  value={form.scheduleDays.length}
                  readOnly
                  className={`
                    ${inputClass}
                    cursor-not-allowed
                    opacity-70
                  `}
                />
              </Field>

              {/* TUITION */}

              <Field
                label="Tuition amount"
                required
              >
                <input
                  required
                  type="number"
                  min="0"
                  step="0.01"
                  value={form.tuitionAmount}
                  onChange={(event) =>
                    updateField(
                      "tuitionAmount",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />
              </Field>

              {/* CURRENCY */}

              <Field
                label="Currency"
                required
              >
                <select
                  required
                  value={form.currency}
                  onChange={(event) =>
                    updateField(
                      "currency",
                      event.target.value
                    )
                  }
                  className={inputClass}
                >
                  <option value="KRW">
                    KRW
                  </option>

                  <option value="USD">
                    USD
                  </option>

                  <option value="CNY">
                    CNY
                  </option>
                </select>
              </Field>

              {/* START DATE */}

              <Field
                label="Start date"
                required
              >
                <input
                  required
                  type="date"
                  value={form.startDate}
                  onChange={(event) =>
                    updateField(
                      "startDate",
                      event.target.value
                    )
                  }
                  className={inputClass}
                />

                <p
                  className="
                    mt-2
                    font-sans
                    text-[12px]
                    leading-5
                    text-[#888]
                  "
                >
                  The start date must fall on one of
                  the selected lesson days.
                </p>
              </Field>
            </div>

            {/* ENROLLMENT STATUS */}

            <div
              className="
                mt-8
                rounded-2xl
                border
                border-[#D8E2D4]
                bg-[#F4F7F2]
                px-5
                py-4
              "
            >
              <p
                className="
                  font-sans
                  text-[11px]
                  font-medium
                  uppercase
                  tracking-[0.12em]
                  text-[#6F8F72]
                "
              >
                Enrollment Status
              </p>

              <p
                className="
                  mt-1
                  font-serif
                  text-[22px]
                  text-[#292929]
                "
              >
                Active
              </p>

              <p
                className="
                  mt-1
                  font-sans
                  text-[12px]
                  leading-5
                  text-[#777]
                "
              >
                New enrollments are automatically marked
                active. The enrollment status describes
                the package, while individual lesson
                outcomes are recorded separately.
              </p>
            </div>

            {/* AUTOMATION */}

            <div
              className="
                mt-6
                rounded-2xl
                border
                border-[#D8E2D4]
                bg-[#F4F7F2]
                px-5
                py-4
              "
            >
              <p
                className="
                  font-sans
                  text-[13px]
                  font-medium
                  text-[#5F7F63]
                "
              >
                Your lesson schedule will be created
                automatically.
              </p>

              <p
                className="
                  mt-1
                  font-sans
                  text-[12px]
                  leading-5
                  text-[#777]
                "
              >
                When you create this enrollment, all{" "}
                {form.numberOfLessons || "scheduled"}{" "}
                lesson records will be generated from
                the selected days and start date.
                Every lesson starts as scheduled.
              </p>
            </div>
          </section>

          {/* POLICY REFERENCE */}

          <section
            className="
              rounded-3xl
              border
              border-[#E7DDD1]
              bg-white
              p-7

              sm:p-9
            "
          >
            <p
              className="
                font-sans
                text-[11px]
                font-medium
                uppercase
                tracking-[0.14em]
                text-[#6F8F72]
              "
            >
              Policy Reference
            </p>

            <h2
              className="
                mt-3
                font-serif
                text-[28px]
                font-normal
              "
            >
              Lesson status follows the Hamkke policy
            </h2>

            <div className="mt-5 overflow-x-auto">
              <table
                className="
                  w-full
                  min-w-[620px]
                  border-collapse
                  font-sans
                  text-[13px]
                "
              >
                <thead>
                  <tr className="border-b border-[#E7DDD1]">
                    <th className="px-3 py-3 text-left font-medium text-[#555]">
                      Situation
                    </th>

                    <th className="px-3 py-3 text-left font-medium text-[#555]">
                      Lesson outcome
                    </th>

                    <th className="px-3 py-3 text-left font-medium text-[#555]">
                      Package credit
                    </th>
                  </tr>
                </thead>

                <tbody>
                  <tr className="border-b border-[#EEE7DF]">
                    <td className="px-3 py-3 text-[#666]">
                      2+ hours' notice
                    </td>

                    <td className="px-3 py-3 text-[#444]">
                      Rescheduled
                    </td>

                    <td className="px-3 py-3 text-[#666]">
                      Preserved
                    </td>
                  </tr>

                  <tr className="border-b border-[#EEE7DF]">
                    <td className="px-3 py-3 text-[#666]">
                      Less than 2 hours' notice
                    </td>

                    <td className="px-3 py-3 text-[#444]">
                      Completed
                    </td>

                    <td className="px-3 py-3 text-[#666]">
                      Used
                    </td>
                  </tr>

                  <tr className="border-b border-[#EEE7DF]">
                    <td className="px-3 py-3 text-[#666]">
                      No-show without notice
                    </td>

                    <td className="px-3 py-3 text-[#444]">
                      Completed
                    </td>

                    <td className="px-3 py-3 text-[#666]">
                      Used
                    </td>
                  </tr>

                  <tr className="border-b border-[#EEE7DF]">
                    <td className="px-3 py-3 text-[#666]">
                      Unexpected circumstance
                    </td>

                    <td className="px-3 py-3 text-[#444]">
                      Review / Reschedule
                    </td>

                    <td className="px-3 py-3 text-[#666]">
                      Case-by-case
                    </td>
                  </tr>

                  <tr>
                    <td className="px-3 py-3 text-[#666]">
                      Teacher cancellation
                    </td>

                    <td className="px-3 py-3 text-[#444]">
                      Replacement / Credit
                    </td>

                    <td className="px-3 py-3 text-[#666]">
                      Preserved
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <p
              className="
                mt-4
                font-sans
                text-[12px]
                leading-5
                text-[#888]
              "
            >
              This reference reflects the current
              Hamkke Lesson Policy. It is informational
              here. The actual lesson outcome should be
              recorded when the lesson is handled.
            </p>
          </section>

          {/* ERROR */}

          {error && (
            <div
              className="
                rounded-2xl
                border
                border-[#E7CFC8]
                bg-[#F8ECE8]
                px-5
                py-4
                font-sans
                text-[14px]
                leading-6
                text-[#8A5148]
              "
            >
              {error}
            </div>
          )}

          {/* SUBMIT */}

          <div
            className="
              flex
              flex-col
              gap-4

              sm:flex-row
              sm:items-center
              sm:justify-between
            "
          >
            <p
              className="
                max-w-md
                font-sans
                text-[13px]
                leading-6
                text-[#777]
              "
            >
              This will create the student, active
              enrollment, and complete lesson schedule
              together.
            </p>

            <button
              type="submit"
              disabled={loading}
              className="
                rounded-full
                bg-[#6F8F72]
                px-8
                py-3.5
                font-sans
                text-[14px]
                font-medium
                text-white
                transition
                hover:bg-[#5F7F63]
                disabled:cursor-not-allowed
                disabled:opacity-60
              "
            >
              {loading
                ? "Creating Schedule..."
                : "Create Enrollment"}
            </button>
          </div>
        </form>
      </div>
    </main>
  );
}

function Field({
  label,
  required = false,
  children,
}: {
  label: string;
  required?: boolean;
  children: React.ReactNode;
}) {
  return (
    <div>
      <label
        className="
          font-sans
          text-[12px]
          font-medium
          uppercase
          tracking-[0.12em]
          text-[#6F8F72]
        "
      >
        {label}

        {required && (
          <span className="ml-1 text-[#A66A5B]">
            *
          </span>
        )}
      </label>

      <div className="mt-2">
        {children}
      </div>
    </div>
  );
}

const inputClass = `
  w-full
  rounded-xl
  border
  border-[#D8CCBE]
  bg-[#FAF8F5]
  px-4
  py-3
  font-sans
  text-[15px]
  text-[#292929]
  outline-none
  transition
  placeholder:text-[#999]
  focus:border-[#6F8F72]
  focus:ring-2
  focus:ring-[#E2EBDD]
`;